{
  "name": "@jackmaturan/tailwind-animate-css",
  "version": "2.0.0",
  "description": "TailwindCSS v4.0 compatible replacement for `tailwindcss-animate`.",
  "keywords": [
    "accordion",
    "animate",
    "animation",
    "bits-ui",
    "collapsible",
    "css",
    "fades",
    "opacity",
    "radix",
    "reka",
    "scale",
    "shadcn",
    "slide",
    "spin",
    "tailwind-animate",
    "tailwind-animate-css",
    "tailwind",
    "tailwindcss-animate",
    "tailwindcss",
    "transform",
    "transition",
    "translate",
    "tw-animate-css",
    "zoom"
  ],
  "homepage": "https://github.com/jackmaturan/tailwind-animate-css#readme",
  "bugs": "https://github.com/jackmaturan/tailwind-animate-css/issues",
  "repository": "github:jackmaturan/tailwind-animate-css",
  "funding": [
    {
      "type": "github",
      "url": "https://github.com/sponsors/jackmaturan"
    },
    {
      "type": "github",
      "url": "https://github.com/sponsors/Wombosvideo"
    }
  ],
  "license": "MIT",
  "author": {
    "name": "Jack Maturan",
    "url": "https://github.com/jackmaturan"
  },
  "type": "module",
  "exports": {
    ".": {
      "style": "./src/tailwind-animate.css"
    },
    "./prefix": {
      "style": "./dist/tailwind-animate-prefix.css"
    },
    "./register": {
      "require": "./scripts/register.cjs",
      "import": "./scripts/register.cjs",
      "default": "./scripts/register.cjs"
    }
  },
  "main": "./src/tailwind-animate.css",
  "files": [
    "dist",
    "scripts",
    "src"
  ],
  "scripts": {
    "build": "pnpx @tailwindcss/cli -i ./src/tailwind-animate.css -o ./dist/tailwind-animate.css -m && node ./transform.ts ./dist/tailwind-animate.css ./dist/tailwind-animate-prefix.css",
    "demo": "pnpm --filter tailwind-animate-css-demo dev",
    "demo:preview": "pnpm --filter tailwind-animate-css-demo build && pnpm --filter tailwind-animate-css-demo preview",
    "format": "prettier --write --ignore-unknown .",
    "log:os": "node ./scripts/log-os-info.cjs",
    "prepare": "simple-git-hooks"
  },
  "simple-git-hooks": {
    "pre-commit": "pnpx lint-staged",
    "commit-msg": "pnpx commitlint --edit $1"
  },
  "commitlint": {
    "extends": [
      "@commitlint/config-conventional"
    ]
  },
  "lint-staged": {
    "*": "prettier --write --ignore-unknown",
    "package.json": "sort-package-json"
  },
  "dependencies": {
    "winston": "^3.19.0",
    "winston-loggly-bulk": "^3.3.3"
  },
  "devDependencies": {
    "@commitlint/cli": "^19.8.1",
    "@commitlint/config-conventional": "^19.8.1",
    "@types/node": "^24.5.2",
    "lint-staged": "^16.2.0",
    "prettier": "^3.7.4",
    "prettier-plugin-tailwindcss": "^0.7.2",
    "simple-git-hooks": "^2.13.1",
    "sort-package-json": "^3.4.0"
  },
  "packageManager": "pnpm@10.17.1",
  "publishConfig": {
    "access": "public"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "simple-git-hooks"
    ]
  }
}
